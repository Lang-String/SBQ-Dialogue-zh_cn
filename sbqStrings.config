    "default": {
      "name": [
        "一堆骸骨"
      ],
      "desc": [
        "这堆骨头意味着有人沦为了食物......"
      ]
    }
  },
  "condomDrop": {
    "both": {
      "name": [
        "被<predName>射进套套里的<preyName>"
      ],
      "desc": [
        "<predName>答应了<preyName>不要消化成食糜的请求，并随即把他塞进了下面。\n至少<predName>还是把它射进了安全套里～",
        "一袋满是精液的避孕套，上面有<predName>留下的便条：\n谢谢你的套套<preyName>！不然某人肚子里就怀上你了～",
        "<predName>将<preyName>握在手中坏笑并说道：\"避孕套儿\"\n很快乳白色的<preyName>就被射进了避孕套内～",
        "一只避孕套，系着<predName>的留言：\n差点就把<preyName>蛇的到处都是，还好准备了套套。不过我打了死结，老实呆在里面吧！",
        "一个大安全套，上面有个标签：\n<predName>将<preyName>塞进蛋蛋里一通狂搅，全力活塞运动之后终于榨出了乳白色的汁水～",
        "一个带着标签的大避孕套：\n<predName>度过了一段愉悦的时光。尽管<preyName>没坚持多久，很快就沦为了精液，并随着喷射被抛弃～",
        "一团圆鼓鼓的白色套套，标签上写道：\n<predName>和<preyName>在一起。你追我，我追你。如果我，追到你，C-U-M-M-I-N-G～"
      ]
    },
    "pred": {
      "name": [
        "射满<predName>精液的大安全套"
      ],
      "desc": [
        "一个大避孕套，纸条的一头被随意地系在结上：\n终究只不过是一滩用于取悦<predName>的浓稠精液～",
        "一只大套套，上面挂着个标签：\n<predName>向你保证，这里面很安全~ 就像在我的蛋蛋里面一样安全～"
      ]
    },
    "forgetful": {
      "name": [
        "被<predName>弄丢了的大避孕套"
      ],
      "desc": [
        "一个贴着照片的大避孕套，打结处系着个标签：\n... 已经忘记你叫啥了，抱歉啦！"
      ]
    },
    "prey": {
      "name": [
        "存放<preyName>的避孕套"
      ],
      "desc": [
        "一团圆鼓鼓的白色套套，标签上写道：\n<preyName>没能在里面坚持多久，没一会就融成了一滩白色粘稠的精液～",
        "一个带有便笺大安全套：\n谢谢你，<preyName>！你居然自带了一个大套套。作为报答我就不把你射到其他的地方了~",
        "一只大避孕套，附带一条记录：\n<preyName>刚被塞进去的时候很抗拒，不过在多重爱抚下，很快就放弃挣扎接受了变成精液的命运～"
      ]
    },
    "default": {
      "name": [
        "某人用过的安全套"
      ],
      "desc": [
        "一个系着标签的大安全套... 字迹与图片无法辨识。"
      ]
    }
  },
