	// digest drops 消化后吐出的掉落物
	"boneDrop" : {
		"both" : { // when theres both valid NPC/Player prey data and a valid pred name. 同时满足有效的猎物NPC/玩家数据和有效的捕食者名称时。
			"name" : [
				"<preyName>的遗骸"
			],
			"desc" : [ // index of name is paired with index of desc, uses first name entry if there is no name entry at the matching index 名称索引与desc描述索引成对出现，如果匹配索引中没有名称条目，则使用名字条目
				"这是美味的<preyName>撞见<predName>后，\n<preyName>留存于世的一切。"
			]
		},
		"pred" : { // when theres only a valid pred name and no valid prey data 当仅出现有效的捕食者名称但不满足有效的猎物数据时
			"name" : [
				"<predName>美餐后的吐出的骨头"
			],
			"desc" : [ // index of name is paired with index of desc, uses first name entry if there is no name entry at the matching index 名称索引与desc描述索引成对出现，如果匹配索引中没有名称条目，则使用名字条目
				"当我们赶到时，现场只看到了<predName>和吐了一地的骨架。"
			]
		},
		"forgetful" : { // 25% chance to roll forgetful, only needs a valid pred name, takes priority if roll is successful even if prey data is valid 25%几率会随机为遗忘掉落物，仅需要有效的捕食者名称，即使猎物数据有效也会随机替换
			"name" : [
				"<predName>不在乎的食丸"
			],
			"desc" : [ // index of name is paired with index of desc, uses first name entry if there is no name entry at the matching index 名称索引与desc描述索引成对出现，如果匹配索引中没有名称条目，则使用名字条目
				"某个受害者被消化后留下的残骸... 恐怕<predName>早已忘了这只食物。"
			]
		},
		"prey" : { // requires valid NPC/Player prey data 需要有效的猎物NPC/玩家数据
			"name" : [
				"<preyName>的残渣"
			],
			"desc" : [ // index of name is paired with index of desc, uses first name entry if there is no name entry at the matching index 名称索引与desc描述索引成对出现，如果匹配索引中没有名称条目，则使用名字条目
				"这是<preyName>飞升后遗留在尘世的存在过的证明......"

			]
		},

		"default" : { // fallbacks for when there is no valid pred or prey data 作为没有有效的捕食者或猎物数据时的替代掉落物
			"name" : [
				"一堆骸骨"
			],
			"desc" : [ // index of name is paired with index of desc, uses first name entry if there is no name entry at the matching index 名称索引与desc描述索引成对出现，如果匹配索引中没有名称条目，则使用名字条目
				"这堆骨头意味着有人沦为了食物......"
			]
		}
	},
	"condomDrop" : {
		"both" : { // when theres both valid NPC/Player prey data and a valid pred name. 同时满足有效的猎物NPC/玩家数据和有效的捕食者名称时。
			"name" : [
				"被<predName>射进套套里的<preyName>"
			],
			"desc" : [ // index of name is paired with index of desc, uses first name entry if there is no name entry at the matching index 名称索引与desc描述索引成对出现，如果匹配索引中没有名称条目，则使用名字条目
				"<predName>答应了<preyName>不想被消化成食糜的请求，并随即把他塞进了下面。\n至少<predName>还是把它射进了安全套里～",
				"一袋满是精液的避孕套，上面有<predName>留下的便条：\n还好你带了套套<preyName>！不然某个可怜的子宫就要因为你怀孕了～",
				"<predName>将<preyName>握在手中坏笑并说道：\"避孕套儿\"\n很快乳白色的<preyName>就被射进了避孕套内～", "一只避孕套，系着<predName>的留言：\n差点就把<preyName>蛇的到处都是，还好准备了套套。不过我打了死结，老实呆在里面吧！",
				"一个大安全套，上面有个标签：\n<predName>将<preyName>塞进蛋蛋里一通狂搅，全力活塞运动之后终于榨出了乳白色的汁水～",
				"一个带着标签的大避孕套：\n<predName>度过了一段愉悦的时光。<preyName>太不持久了，很快就化成了精液，至少喷射的时候挺爽的～",
				"一团圆鼓鼓的白色套套，标签上写道：\n<predName>和<preyName>在一起。你追我，我追你。如果我，追到你，C-U-M-M-I-N-G～"
			]
		},
		"pred" : { // when theres only a valid pred name and no valid prey data 当仅出现有效的捕食者名称但不满足有效的猎物数据时
			"name" : [
				"射满<predName>精液的大安全套"
			],
			"desc" : [ // index of name is paired with index of desc, uses first name entry if there is no name entry at the matching index 名称索引与desc描述索引成对出现，如果匹配索引中没有名称条目，则使用名字条目
				"一个大避孕套，纸条的一头被随意地系在结上：\n终究只不过是一滩用于取悦<predName>的浓稠精液～",
				"一只大套套，上面挂着个标签：\n<predName>向你保证，这里面很安全~ 就像不久前在我的身体里面一样安全～"
			]
		},
		"forgetful" : { // 25% chance to roll forgetful, only needs a valid pred name, takes priority if roll is successful even if prey data is valid 25%几率会随机为遗忘掉落物，仅需要有效的捕食者名称，即使猎物数据有效也会随机替换
			"name" : [
				"被<predName>弄丢了的大避孕套"
			],
			"desc" : [ // index of name is paired with index of desc, uses first name entry if there is no name entry at the matching index 名称索引与desc描述索引成对出现，如果匹配索引中没有名称条目，则使用名字条目
				"一个贴着照片的大避孕套，打结处系着个标签：\n... 已经忘记你叫啥了，抱歉啦！"
			]
		},
		"prey" : { // requires valid NPC/Player prey data 需要有效的猎物NPC/玩家数据
			"name" : [
				"存放<preyName>的避孕套"
			],
			"desc" : [ // index of name is paired with index of desc, uses first name entry if there is no name entry at the matching index 名称索引与desc描述索引成对出现，如果匹配索引中没有名称条目，则使用名字条目
				"一团圆鼓鼓的白色套套，标签上写道：\n<preyName>没能在里面坚持多久，没一会就融成了一滩白色粘稠的精液～",
				"一个带有便笺大安全套：\n谢谢你，<preyName>！你居然自带了一个大套套。作为报答我就不把你射到其他的地方了~",
				"一只大避孕套，附带一条记录：\n<preyName>刚被塞进去的时候很抗拒，不过在多重爱抚下，很快就放弃挣扎接受了变成精液的命运～"
			]
