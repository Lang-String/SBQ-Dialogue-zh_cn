  "oralVoreNoPrompt": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:oralVoreNoPrompt",
  "oralVoreNoPromptAfter": ":oralVoreRequestedAfter",
  "cockVoreNoPrompt": [
    "惊讶吧！",
    "逮到你了！",
    "抱歉，但我得这么做~",
    "我欲火焚身了，过来～"
  ],
  "cockVoreNoPromptAfter": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:cockVoreNoPromptAfter",
  "oralVoreUnprompted": [
    "呃呜，好黏糊。",
    "很高兴能填饱你的肚子^^",
    "我永远都习惯不了这个 >~<"
  ],
  "cockVoreUnprompted": [
    "嘿嘿，现在好玩的来了！",
    "呃..有什么进到我嘴里了！",
    "天呐，这里真紧。",
    "将朋友们塞进蛋蛋里...嘿嘿，Auri会很自豪的。",
    "需要补充精力？乐意帮忙^^",
    "我永远都习惯不了这个 >~<"
  ],
  "oralVoreLetoutUnpromptedAfter": [
    "所以这就是被吞下去的感觉。",
    "我永远都适应不了这个。"
  ],
  "cockVoreLetoutUnpromptedAfter": [
    "好咸啊... 呸。",
    "都到我嘴里了..."
  ],
  "oralVoreForcing": "/npcs/sbq/dialogue/default.dialogue:oralVoreForcing",
  "cockVoreForcing": "/npcs/sbq/dialogue/default.dialogue:cockVoreForcing",
  "oralVoreLetoutForcingAfter": [
    "不能否认胃里面还挺舒服的。",
    "啊，真是一次难忘的经历。"
  ],
  "cockVoreLetoutForcingAfter": [
    "啊，天呐...弄得我毛上到处都是。",
    "天啊..我得花好久才能把精液洗掉。"
  ],
  "oralVoreForced": "/npcs/sbq/dialogue/default.dialogue:oralVoreForced",
  "cockVoreForced": "/npcs/sbq/dialogue/default.dialogue:cockVoreForced",
  "oralVoreLetoutForced": [
    "*唔..咳咳*...",
    "好了好了，快出来吧。",
    "嗷呜，天呐..快点..."
  ],
  "cockVoreLetoutForced": [
    "啊~天呐，这感觉太棒了～",
    "随时都欢迎再来^^",
    "有你在里面感觉真好～",
    "怎么？在里面玩得不开心么？",
    "咩噗...."
  ],
  "struggleBelly": [
    "好好享受吧！",
    "舒服吗？",
    "咩噗？"
  ],
  "struggleCock": [
    "哦哦，嘿嘿，感觉痒痒的~",
    "哇哦，好家伙..."
  ],
  "struggleBalls": [
    "咩噗...下面感觉真好。",
    "继续动。",
    "你在里面的感觉太棒了～",
    "将朋友们塞进蛋蛋里~"
  ],
  "struggleAcidHeal": [
    "放松...你受伤了。",
    "别乱动..好好养伤。"
  ],
  "struggleCumHeal": [
    "我的种子能填补伤口，所以别慌。你会没事的，我发誓！",
    "你还能这么用力扭动，看来身体还挺健康的！",
    "放松点，让我这黏糊糊的\"桑拿间\"安抚你。"
  ],
  "struggleCumHealCock": [
    "我知道这很奇怪，但这能治好你。所以别担心待在我鸡儿里！",
    "我给你疗伤的时候，你不用动这么厉害，除非你想去我蛋蛋那儿...",
    "虽然我还挺享受你挣扎的，但还请理解，你在我肉棒里很安全。"
  ],
  "struggleCompression": "/npcs/sbq/dialogue/default.dialogue:struggleCompression",
  "struggleAcidDigest": [
    "溶解食物的感觉真好～",
    "乖乖当块美味的点心，溶化掉吧～",
    "我正好好地把你消咩掉呢.. 嘿嘿。"
  ],
  "struggleAcidDigestImmune": [
    "咩噗？",
    "感觉你没在融化啊。"
  ],
  "struggleCumDigest": [
    "嗯嗯，就这样溶解掉吧~",
    "给我咩噗掉～"
  ],
  "struggleCumDigestBalls": [
    "对，变成美妙的鲨狗精子吧~",
    "是时候变成鲨狗的精液啦~"
  ],
  "struggleCumDigestImmune": [
    "溶解不掉...",
    "某只鲨狗很想融化你。",
    "少废话，多溶化。",
    "赶紧融化并好好享受这过程。"
  ],
  "struggleDrainEnergy": "/npcs/sbq/dialogue/default.dialogue:struggleDrainEnergy",
  "strugglingBelly": [
    [
      "舒服",
      "原来在肚子里是这种感觉",
      {
        "check": {
          "bellySounds": true
        },
        "add": [
          "*咕噜咕噜*",
          "姆唔，这里面的声音..",
          "*挣扎的闷咕声*...嗷，我放弃了..."
        ]
      }
    ],
    {
      "check": {
        "predator": "sbqVaporeon"
      },
      "add": [
        "黏糊糊的水伊布肚子。",
        "这里面又粘又滑。"
      ]
    }
  ],
  "strugglingCock": [
    "对..狠狠挤压我~",
    "舒服又浓郁",
    "这太刺激了～"
  ],
  "strugglingBalls": "/npcs/sbq/dialogue/default.dialogue:strugglingBalls",
  "strugglingAcidHeal": [
    "唔...它没在消化我..很棒，对吧？",
    "好像一次治疗浴。",
    "这感觉太棒了！"
  ],
  "strugglingCumHeal": ":strugglingAcidHeal",
  "strugglingCumHealCock": ":strugglingAcidHeal",
  "strugglingCumHealBalls": [
    "你的治愈精液冲刷着我，我感觉伤痛在消失！",
    "看来你的蛋蛋是个很棒的疗养桑拿水疗中心。",
    "你那浓稠精华的舒缓效果太疯狂了，真新奇。"
  ],
  "strugglingMiscHeal": ":strugglingAcidHeal",
  "strugglingCompression": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:strugglingCompression",
  "strugglingAcidDigest": [
    "老兄，好痛...",
    "呜..只是一堆脂肪了..."
  ],
  "strugglingAcidDigestImmune": [
    [
      "在试着消化我么？",
      "想把我融化掉？\n不管用哦。"
    ],
    "呵，我在这里想待多久就待多久。",
    "我@#%@@#$无敌啦！*此处插入《合金装备崛起》的梗*",
    "我免疫，祝你好运。"
  ],
  "strugglingCumDigest": [
    "这里面好烫，你的精液... 是在溶解我吗？",
    "我觉得你的精液在把我软化！",
    "在这里面我感觉变得好软好黏..."
  ],
  "strugglingCumDigestBalls": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:strugglingCumDigestBalls",
  "strugglingCumDigestImmune": [
    "我不觉得你的精液能溶解我。",
    "你得清楚，你的种子软化不了我。",
    "我能抵抗你精液对我的溶解！"
  ],
  "strugglingMiscDigest": ":strugglingAcidDigest",
  "strugglingMiscDigestImmune": ":strugglingAcidDigestImmune",
  "strugglingTransforming": [
    "怎么回事？我感觉我正在这里面发生变化！",
    "我越在这里面挣扎，就越觉得自己不像自己了...",
    "你在对我做什么？我变得奇怪起来了！"
  ],
  "strugglingDrainEnergy": [
    "你在我动的时候汲取我的能量...",
    "我几乎没力气... 再抵抗这个了...",
    "你在吸取我的能量，我还能挣扎多久呢...？"
  ],
  "strugglingEggify": [
    "这-这在我周围形成的壳是怎么回事?！",
    "嘿，这里的东西在我周围变硬了，发生什么事了!？",
    "肉壁在变硬，哦等等，有什么东西在我周围形成?！"
  ],
  "strugglingVaporeon": [
    "你知道吗-*被晃来晃去*..还是算了.."
  ],
  "climax": "/npcs/sbq/dialogue/default.dialogue:climax",
  "climaxCock": "/npcs/sbq/dialogue/default.dialogue:climaxCock",
  "climaxBalls": "/npcs/sbq/dialogue/default.dialogue:climaxBalls",
  "shrinking": [
    "哦，天呐，又要开始喽...",
    "感觉很不错。",
    "哈，我确实很喜欢变得小小的。",
    "哈..记着，小不点儿就是用来踩在脚下的^^",
    "好耶！"
  ],
  "growing": [
    "不是我最喜欢的，但我也能接受。",
    "让我想起了我的前任。",
    "*撞到脑袋* 嗷呜....",
    "哈... 我们一直都被看作是大块头。"
  ],
  "didSteppy": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:didSteppy",
  "gotStepped": [
    "哦唔...",
    "*被踩扁的声音*",
    "哎哟......",
    "....呃呃呃...",
    "哎呀！走路看着点！",
    "..呃额... 谢谢。",
    "咩噗....",
    "咩噗！",
    "啊... 小不点儿的生活真不好过.."
  ],
  "gotStomped": "/npcs/sbq/dialogue/default.dialogue:gotStomped",
  "gotSteppedWalking": [
    "诶，我在下面走得好好的！",
    "哇哦..爪子来了。",
    "哇哦...走路看着点！",
    "哇...*摔个屁股蹲*..哎哟"
  ],
  "vanilla": "/npcs/sbq/dialogue/default.dialogue:vanilla",
  "strugglingGurgleSoundsDigest": [
    "一直在...咕噜咕噜响。",
    "咕噜个不停... 你肯定饿极了。"
  ],
  "strugglingGurgleSoundsBelly": [
    "我真的很喜欢你肚子发出的声音... 非常令人安心。",
    "听着你身体发出的声音，我都能睡着了..."
  ],
  "full": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:breastInfuseFull",
  "struggleCockInfused": [
    "啊啊啊～ 有<entityName>在下面感觉太棒了~",
    "<keysmash>，你要让<entityName>射出来了~"
  ],
  "oralVoreLetoutForcedDigest": [
    "哦..哈，那享受待在外面的时光吧。",
    "没生气吧？",
    "你可真没意思。",
    "哦？看来这儿有个硬骨头。"
  ],
  "oralVoreLetoutForcedDigestImmune": [
    "好吧..反正我也没那么饿。",
    "你让我在其他人面前很难堪。",
    "拜托...这是我的工作。"
  ],
  "oralVoreLetoutForcedSoftDigest": [
    "什... 你不会有事的..哎呀...",
    "什么？你选了那个选项啊。",
    "好吧...那你就享受你的自由吧，我猜。"
  ],
  "oralVoreLetoutForcedSoftDigestImmune": [
    "该死... 我好饿... 而你却一点都没消化。",
    "没生气吧？反正我的酸液也没起什么作用。",
    "拜托，我的酸液对你一点效果都没有...",
    "要是你真的能开始溶化就好了..."
  ],
  "oralVoreLetoutForcedHeal": [
    "别这样..这里面就像个桑拿房。",
    "你确定你准备好出来了？",
    "好吧...要是你需要治疗，就再来找我。",
    "你可别因为没完全治好导致死翘翘而抱怨哦。",
    "下次别一直喊我需要治疗了。"
  ],
  "oralVoreLetoutRequestedDigested": [
    "该送你上路啦！",
    "彻底消化吧，哈哈",
    "希望这值得你丢失的像素。",
    "等明年你回来我还消化你。"
