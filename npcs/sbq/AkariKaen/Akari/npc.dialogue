{
  "greetingRewards": "/npcs/sbq/dialogue/default.dialogue:greetingRewards",
  "greetingRewardsIntroduced": "/npcs/sbq/dialogue/default.dialogue:greetingRewardsIntroduced",
  "greeting": [
    "啊，你好啊。",
    "咩噗？",
    "什么事？",
    "啥事？"
  ],
  "greetingCrew": "/npcs/sbq/dialogue/default.dialogue:greetingCrew",
  "crewStay": "/npcs/sbq/dialogue/default.dialogue:crewStay",
  "fullCrew": "/npcs/sbq/dialogue/default.dialogue:fullCrew",
  "crewFollow": "/npcs/sbq/dialogue/default.dialogue:crewFollow",
  "converse": [
    "你想要聊点什么吗？",
    "咩噗？"
  ],
  "introduce": [
    "嗯...\n很高兴认识你，<entityName>！"
  ],
  "talkAboutSelf": [
    "唔，我自己没啥可说的，咩噗。"
  ],
  "talkAboutSelfWhatAreYou": [
    "从没见过一只鲨狗吗？好吧，我的家园星球是Tal，那里有好几个种族和氏族。我住在一个叫金环的大城市，那里主要住着南鲨狗族人，我也经常被叫做\"城里娃\"。"
  ],
  "talkAboutSelfWhyMerp": [
    "我嘛... *清了清嗓子* 这是我们能发出的一种有趣声音。曾经很流行... 但现在都成一个我们老套的标志性声音了。不过一旦我们咩噗了起来，那你能听到的就只有咩噗了。"
  ],
  "talkAboutSelfCheeseJoke": [
    "*嗷* 呜，你好聪明呀... 又不是我这辈子没听过几千遍刻板笑话... 但我也没法阻止你自得其乐。"
  ],
  "talkAboutSelfKinks": [
    "嗯... 我可以讲讲这个模组里一些值得一提的癖好。"
  ],
  "talkAboutKinks": [
    "所以你想聊一聊癖好？"
  ],
  "talkAboutKinksMacroMicro": [
    "大概你最常看到的就是我与大小相关的交互。我喜欢变成小小只，这也是我跟其他癖好联动的主要方式。我超爱作为小小只待在巨大生物的房子里，躲避他们的脚步～"
  ],
  "talkAboutKinksPaws": [
    "啊... 对，关于爪子... 无论作为正常体型还是小小只，我都很享受侍奉满足它们以及被踩在脚下的愉悦...尤其是人类玉足，我最喜欢了！"
  ],
  "talkAboutKinksVore": [
    "并不是我最在意的癖好，但就这个模组来说，我会选张嘴丸吞(OV)和阴茎吸食(CV)。不过得是变小后，这样在我脑海里才更带感。"
  ],
  "rewardNotifyMoney": "/npcs/sbq/dialogue/default.dialogue:rewardNotifyMoney",
  "rewardNotifyLowValueQuestRewards": "/npcs/sbq/dialogue/default.dialogue:rewardNotifyLowValueQuestRewards",
  "rewardNotifyMediumValueQuestRewards": "/npcs/sbq/dialogue/default.dialogue:rewardNotifyMediumValueQuestRewards",
  "rewardNotifyHighValueQuestRewards": "/npcs/sbq/dialogue/default.dialogue:rewardNotifyHighValueQuestRewards",
  "oralVoreRequested": "/npcs/sbq/dialogue/default.dialogue:oralVoreRequested",
  "oralVoreRequestedAfter": "/npcs/sbq/dialogue/default.dialogue:oralVoreRequestedAfter",
  "oralVoreInvalid": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:oralVoreInvalid",
  "oralVoreNo": ":defaultNo",
  "oralVoreTooBig": ":tooBig",
  "tooBig": "/npcs/sbq/dialogue/default.dialogue:tooBig",
  "oralVoreTooSmall": ":tooSmall",
  "tooSmall": "/npcs/sbq/dialogue/default.dialogue:tooSmall",
  "oralVoreNoSlots": ":noSlots",
  "noSlots": "/npcs/sbq/dialogue/default.dialogue:noSlots",
  "oralVoreFull": "/npcs/sbq/dialogue/default.dialogue:oralVoreFull",
  "oralVoreNeedsInfusion": "/npcs/sbq/LokiVulpix/Loki/npc.dialogue:oralVoreNeedsInfusion",
  "needsInfusion": ":oralVoreNeedsInfusion",
  "oralVoreAlreadyInfused": [
    "我觉得那儿已经有东西了。"
  ],
  "alreadyInfused": ":oralVoreAlreadyInfused",
  "oralVoreTargetPreySettingsMismatch": [
    "你体内的某只食物大抵不喜欢那样。"
  ],
  "targetPreySettingsMismatch": ":oralVoreTargetPreySettingsMismatch",
  "cockVoreRequested": [
    "哈哈，馋鲨狗的鸡儿了？",
    "咩噗？你想进我鸡儿里？",
    "希望你能塞得下。",
    "嗯？那就进来吧。"
  ],
  "cockVoreRequestedAfter": [
    "哦哦，咩噗啊，这让我硬起来了~",
    "Caaa~你让这只鲨狗超开心的。",
    "好棒...我硬了..希望没人注意到...",
    "咩..咩噗咩噗～"
  ],
  "cockVoreInvalid": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:cockVoreInvalid",
  "cockVoreNo": [
    "没那个情趣，伙计。",
    "我忙着呢。",
    "也许晚点吧，我刚才自己解决过了。",
    "我还有其他鲨狗的事儿要做... 比如更多咩噗。",
    "我的鸡儿累了。"
  ],
  "cockVoreTooBig": [
    "抱歉，只接受小小只。",
    "哇，要不你缩小点，然后我会考虑考虑。",
    "找Auri要个缩小枪并对自己来几下，然后再来找我。",
    "只接受小入们",
    "你特咩太大了。"
  ],
  "cockVoreTooSmall": ":tooSmall",
  "cockVoreNoSlots": ":noSlots",
  "cockVoreFull": [
    "这根奶酪发射器已经塞满了...",
    "嗯，如果有人钻进我蛋蛋里，你就能挤进去了~",
    "这只鲨狗的鸡儿塞满了。",
    "等我射一滩鲨狗精液再说吧。"
  ],
  "cockVoreNeedsInfusion": ":oralVoreNeedsInfusion",
  "cockVoreAlreadyInfused": ":oralVoreAlreadyInfused",
  "cockVoreTargetPreySettingsMismatch": ":oralVoreTargetPreySettingsMismatch",
  "oralVoreLetoutRequested": [
    "好了，你出去吧。",
    "*咳咳* 出去吧。",
    "呕...你尝起来真不怎么样。",
    "出来吧，我们还有事要做 *打嗝* 呃，不好意思。"
  ],
  "cockVoreLetoutRequested": [
    "嗯嗯嗯我要射了...",
    "姆..嗯哼，天啊～",
    "要射了～",
    "咩..咩噗噗....～"
  ],
  "reformRequested": [
    "重生中心",
    "哔哔啵啵，重塑中..哈哈，开玩笑的，我又不是Synth... 噢，希望Blue没听到这话。",
    "好了，是时候重塑了。"
  ],
