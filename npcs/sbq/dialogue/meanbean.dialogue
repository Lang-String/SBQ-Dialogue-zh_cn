	"breastVoreInvalid": "/npcs/sbq/dialogue/default.dialogue:breastVoreInvalid",
	"breastVoreNo": [
		"这地方不太能见光，伙计。我正在处理里面的硬物。"
	],
	"breastVoreTooBig": ":tooBig",
	"breastVoreTooSmall": ":tooSmall",
	"breastVoreNoSlots": ":noSlots",
	"breastVoreFull": [
		"很嫉妒在里面的是别人而不是你？可惜没地方了，你就在外面嫉妒吧。",
		"做不到，但你可以尝尝我新鲜榨出的乳汁。好喝不贵，随机口味！",
		"找个别的藏身之处吧，伙计。这两边都已经满员了。"
