	"oralVoreLetoutForcingAfterHeal": "/npcs/sbq/FFWizard/Helena/npc.dialogue:oralVoreLetoutForcingAfterHeal",
	"analVoreLetoutForcingAfterDigest": "/npcs/sbq/FFWizard/Helena/npc.dialogue:analVoreLetoutForcingAfterDigest",
	"analVoreLetoutForcingAfterDigestImmune": "/npcs/sbq/FFWizard/Helena/npc.dialogue:analVoreLetoutForcingAfterDigestImmune",
	"analVoreLetoutForcingAfterSoftDigest": ":analVoreLetoutForcingAfterDigest",
	"analVoreLetoutForcingAfterHeal": "/npcs/sbq/FFWizard/Helena/npc.dialogue:analVoreLetoutForcingAfterHeal",
	"tailVoreLetoutForcingAfterDigest": [
		"呼，我在变成你尾巴的食物之前爬出来了。"
	],
	"tailVoreLetoutForcingAfterDigestImmune": [
		"看来我从你尾巴里逃出来了，虽然你的尾巴也咬不动我。"
	],
	"tailVoreLetoutForcingAfterSoftDigest": ":tailVoreLetoutForcingAfterDigest",
	"tailVoreLetoutForcingAfterHeal": [
		"我从你尾巴里扭出来了，哇，在里面待过后，我感觉棒极了！"
	],
	"absorbVoreLetoutForcingAfterDigest": [
		"谢天谢地，我从你身体里出来了，我差点就成为你体内的合金骨架了！"
	],
	"absorbVoreLetoutForcingAfterDigestImmune": [
		"看来我从你身体里出来了，不过你也只能包裹着我无可奈何。"
	],
	"absorbVoreLetoutForcingAfterSoftDigest": ":absorbVoreLetoutForcingAfterDigest",
	"absorbVoreLetoutForcingAfterHeal": [
		"我成功从你那舒适的身体里出来了，感觉棒极了！"
	],
	"cockVoreLetoutForcingAfterDigest": "/npcs/sbq/FFWizard/Helena/npc.dialogue:cockVoreLetoutForcingAfterDigest",
	"cockVoreLetoutForcingAfterDigestImmune": "/npcs/sbq/FFWizard/Helena/npc.dialogue:cockVoreLetoutForcingAfterDigestImmune",
