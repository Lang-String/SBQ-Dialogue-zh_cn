	"oralVoreLetoutUnpromptedAfterHeal": "/npcs/sbq/FFWizard/Helena/npc.dialogue:oralVoreLetoutUnpromptedAfterHeal",
	"navelVoreLetoutUnpromptedAfterSoftDigest": [
		"呼！谢天谢地，你把我从肚脐里挤出来了，我差点就被溶化了！"
