	"struggleDrainEnergy": "/npcs/sbq/dialogue/default.dialogue:struggleDrainEnergy",
	"struggleEggify": "/npcs/sbq/LokiVulpix/Clover/npc.dialogue:struggleEggify",
	"anyInfusedOccupant": "/npcs/sbq/dialogue/default.dialogue:anyInfusedOccupant",
	"thighsInfusedOccupant": "/npcs/sbq/dialogue/default.dialogue:thighsInfusedOccupant",
	"bellyInfusedOccupant": "/npcs/sbq/dialogue/default.dialogue:bellyInfusedOccupant",
	"breastInfusedOccupant": "/npcs/sbq/dialogue/default.dialogue:breastInfusedOccupant",
	"pussyInfusedOccupant": "/npcs/sbq/dialogue/default.dialogue:pussyInfusedOccupant",
	"cockInfusedOccupant": "/npcs/sbq/dialogue/default.dialogue:cockInfusedOccupant",
	"pawInfusedOccupant": "/npcs/sbq/dialogue/default.dialogue:pawInfusedOccupant",
	"tailInfusedOccupant": "/npcs/sbq/dialogue/default.dialogue:tailInfusedOccupant",
	"strugglingBelly": [
		[
			"嗯姆，根据我的计算，相当舒服～",
			"哦喔，你的肚子似乎很适合我，这里面好舒服~",
			{
				"check": {
					"bellySounds": true
				},
				"add": [
					"你肚子发出的咕噜声对我的听觉感受器来说太舒缓了～",
					"嗯... 我应该把这些声音保存到存储器里，这样我就有腹鸣声助睡了~"
				]
			}
		],
		{
			"check": {
				"predator": [
					"sbqVaporeon",
					"vaporeon"
				]
			},
			"add": [
				"这难道算是... 你捕捉到我了？",
				"你的身体真有趣，这就像被水床挤压着~"
			]
		}
	],
	"strugglingWomb": "/npcs/sbq/LokiVulpix/Auri/npc.dialogue:strugglingWomb",
	"strugglingTail": "/npcs/sbq/dialogue/default.dialogue:strugglingTail",
	"strugglingBreasts": "/npcs/sbq/dialogue/default.dialogue:strugglingBreasts",
	"strugglingBreastsShirt": "/npcs/sbq/dialogue/default.dialogue:strugglingBreastsShirt",
	"strugglingPussy": "/npcs/sbq/dialogue/default.dialogue:strugglingPussy",
	"strugglingCock": [
		"啊～你这紧紧的感觉是在对我做压力测试么？",
		"我还是会拼命扭动的，所以别太'自大'哦，嘿～",
		"这太涩情了~！我才不是玩具，就算我看起来像，而且也喜欢被当作玩具对待~"
	],
	"strugglingBalls": [
		"这太淫荡了！但我喜欢~... 我要把这个想法存进一个秘密文件里...",
		"被存放进了这里... 这就意味着我们是朋友了?!~",
		"当你说要带我\"荡秋千\"时，我没想到你指的是这个，不是在抱怨哦~",
		"我很高兴有个先进的冷却系统，因为这里面超级火热~"
	],
	"strugglingAss": "/npcs/sbq/dialogue/default.dialogue:strugglingAss",
	"strugglingAcidHeal": [
		[
			"啊... 好舒服。",
			"我真不敢相信你的治愈能力，连我的合金部件都能修复~",
			"舒适度100%，修复剩余时间... 姆，等我小睡一会儿之后再说吧？",
			{
				"check": {
					"bellySounds": true
				},
				"add": [
					"你肚子发出的咕噜声对我的听觉感觉器来说太舒缓了~",
					"嗯... 我应该把这些声音保存到储存器里，这样就有腹鸣声助眠了~"
				]
			}
		],
		{
			"check": {
				"predator": [
					"sbqVaporeon",
					"vaporeon"
				]
			},
			"add": [
				"这个胃袋内的液体跟治愈之水一样！感觉太棒了。"
			]
		}
	],
